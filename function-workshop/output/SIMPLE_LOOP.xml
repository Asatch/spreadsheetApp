<?xml version="1.0" encoding="UTF-8"?>
<CodeCalculation name="SIMPLE_LOOP" sheetType="loop">
  <LangSpecs/>
  <TestCases>
    <test_case>
      <input_value Value="100"/>
      <input_value Value="2"/>
      <output_value Value="100"/>
    </test_case>
  </TestCases>

  <Nodes>
    <Node node_id="1" node_type="input" data_type="Number" key="START" canonical="100" input_order="0" input_name="START"/>
    <Node node_id="2" node_type="input" data_type="Number" key="YEARS" canonical="2" input_order="1" input_name="YEARS"/>

    <!-- D0: balance carry -->
    <Node node_id="10" node_type="function" data_type="Number" key="D0" canonical="=START" function_name="PROCEED"/>
    <!-- E0: counter -->
    <Node node_id="11" node_type="constant" data_type="Number" key="E0" canonical="0" value="0"/>

    <!-- A1: read previous balance -->
    <Node node_id="20" node_type="function" data_type="Number" key="A1" canonical="=D0" function_name="PROCEED"/>
    <!-- D1: new balance = A1 (no change for now) -->
    <Node node_id="21" node_type="function" data_type="Number" key="D1" canonical="=A1" function_name="PROCEED"/>
    <!-- E1: counter + 1 -->
    <Node node_id="22" node_type="function" data_type="Number" key="E1" canonical="=E0+1" function_name="ADD"/>
    <!-- Stop when E1 >= YEARS -->
    <Node node_id="30" node_type="function" data_type="Boolean" key="_STOP1" canonical="=E1&gt;=YEARS" function_name="GREATEREQUAL"/>

    <Node node_id="40" node_type="constant" data_type="Number" value="1"/>
  </Nodes>

  <NamedNodes>
    <NamedNode node_name="START" node_name_type="alias" node_id="1"/>
    <NamedNode node_name="YEARS" node_name_type="alias" node_id="2"/>
    <NamedNode node_name="D0" node_name_type="address" node_id="10"/>
    <NamedNode node_name="E0" node_name_type="address" node_id="11"/>
    <NamedNode node_name="A1" node_name_type="address" node_id="20"/>
    <NamedNode node_name="D1" node_name_type="address" node_id="21"/>
    <NamedNode node_name="E1" node_name_type="address" node_id="22"/>
    <NamedNode node_name="_STOP1" node_name_type="address" node_id="30"/>
  </NamedNodes>

  <NodeComments/>

  <Outputs>
    <Output output_name="D" output_order="0" data_type="Number" key="D" output_mode="last"/>
  </Outputs>

  <NodeDependencies>
    <NodeDependency child_node_id="10" parent_node_id="1" parent_position="0"/>
    <NodeDependency child_node_id="20" parent_node_id="10" parent_position="0"/>
    <NodeDependency child_node_id="21" parent_node_id="20" parent_position="0"/>
    <NodeDependency child_node_id="22" parent_node_id="11" parent_position="0"/>
    <NodeDependency child_node_id="22" parent_node_id="40" parent_position="1"/>
    <NodeDependency child_node_id="30" parent_node_id="22" parent_position="0"/>
    <NodeDependency child_node_id="30" parent_node_id="2" parent_position="1"/>
  </NodeDependencies>

  <CustomFunctions/>
  <SpreadsheetMeta version="1.0" gridRows="3" gridCols="F"/>
</CodeCalculation>
